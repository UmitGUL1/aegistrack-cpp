{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "AEGISTRACK_BUILD_TESTS": "ON",
        "AEGISTRACK_BUILD_BENCHMARKS": "ON",
        "AEGISTRACK_BUILD_CLI": "ON"
      }
    },
    {
      "name": "default",
      "displayName": "Default Release Build",
      "description": "Release build with GUI (if Qt6 available), CLI, tests, and benchmarks",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AEGISTRACK_BUILD_GUI": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug Build",
      "description": "Debug build with full symbols and assertions",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AEGISTRACK_BUILD_GUI": "ON"
      }
    },
    {
      "name": "headless",
      "displayName": "Headless Release Build",
      "description": "Core engine, CLI, tests, and benchmarks without Qt6 GUI",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AEGISTRACK_BUILD_GUI": "OFF"
      }
    },
    {
      "name": "sanitizers",
      "displayName": "ASan + UBSan Build",
      "description": "Debug build with AddressSanitizer and UndefinedBehaviorSanitizer enabled",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AEGISTRACK_BUILD_GUI": "OFF",
        "AEGISTRACK_BUILD_BENCHMARKS": "OFF",
        "AEGISTRACK_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "vcpkg-release",
      "displayName": "Pinned vcpkg Headless Release",
      "description": "Headless manifest build with no FetchContent fallback",
      "inherits": "headless",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "AEGISTRACK_FETCH_MISSING_DEPENDENCIES": "OFF"
      }
    },
    {
      "name": "vcpkg-desktop",
      "displayName": "Pinned vcpkg Desktop Release",
      "description": "Opt into manifest GUI dependencies; Qt build can be lengthy",
      "inherits": "vcpkg-release",
      "cacheVariables": {
        "AEGISTRACK_BUILD_GUI": "ON",
        "VCPKG_MANIFEST_FEATURES": "gui"
      }
    }
  ],
  "buildPresets": [
    { "name": "vcpkg-release", "configurePreset": "vcpkg-release" },
    { "name": "vcpkg-desktop", "configurePreset": "vcpkg-desktop" },
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "headless",
      "configurePreset": "headless"
    },
    {
      "name": "sanitizers",
      "configurePreset": "sanitizers"
    }
  ],
  "testPresets": [
    { "name": "vcpkg-release", "configurePreset": "vcpkg-release", "output": { "outputOnFailure": true } },
    { "name": "vcpkg-desktop", "configurePreset": "vcpkg-desktop", "output": { "outputOnFailure": true } },
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "headless",
      "configurePreset": "headless",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "sanitizers",
      "configurePreset": "sanitizers",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
